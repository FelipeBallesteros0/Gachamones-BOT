[Unit]
Description=Bot de Discord Tamagotchi (mascotas ASCII)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=felipe
WorkingDirectory=/home/felipe/tamagotchi-bot
ExecStart=/home/felipe/tamagotchi-bot/venv/bin/python bot.py
Restart=always
RestartSec=10
# El bot escribe en tamagotchi.db, dentro de su propio directorio.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
