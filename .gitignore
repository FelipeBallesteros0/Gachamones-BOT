# El token vive aquí. Nunca se sube.
.env

venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Índices locales de code intelligence.
.codegraph/
.gitnexus/
# Lo que genera GitNexus con `analyze` a secas: nombra funciones del momento en
# que se generó y envejece con cada cambio. Se refresca con `analyze --index-only`.
.claude/skills/generated/

# Preferencias privadas de Claude por worktree.
CLAUDE.local.md

# Servidores MCP locales. Lleva rutas de una máquina concreta —dónde está el
# clon de aseprite-mcp y dónde el ejecutable de Aseprite—, así que cada quien
# tiene el suyo y no se comparte.
.mcp.json

# Las mascotas de cada servidor.
*.db

# Lo que sube el dibujante: vive sólo en el servidor, junto a la base, como ella.
/arte_subido/
# Su espejo, que saca `actualizar-pi.sh` en la Pi antes de tocar nada (sólo gana lo nuevo).
/arte_subido.copia/
# Las copias comprimidas de antes, que ya no se rotan.
/arte_subido.*.tar.gz

# Las copias que hace `actualizar-pi.sh` antes de tocar la Pi. Viven sólo ahí.
*.db.*.bak
