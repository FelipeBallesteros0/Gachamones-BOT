# Copia este fichero a .env y rellena los valores.
# El .env NO se sube a git ni viaja en el deploy.

# https://discord.com/developers/applications -> tu app -> Bot -> Reset Token
DISCORD_TOKEN=

# Canal donde vive el bot (el único donde atiende /vincular). Clic derecho en el canal -> Copiar ID
# (Ajustes -> Avanzado -> Modo desarrollador)
#
# Para varios canales, sepáralos por comas:
#   CANAL_ID=123456789012345678,987654321098765432
CANAL_ID=

# Servidores donde registrar los comandos al instante (clic derecho en el icono
# del servidor -> Copiar ID). Sin esto Discord tarda hasta una hora.
# También admite varios separados por comas:
#   GUILD_ID=123456789012345678,987654321098765432
#
# Cada servidor lleva sus propios gachamones. Recuerda meter en CANAL_ID el
# canal de cada uno.
GUILD_ID=

# Opcional: el servidor de Discord que hace de pueblo en la web. Sólo ahí
# funciona /vincular. Si se deja vacío vale el primero de GUILD_ID.
GUILD_WEB=

# Opcional: la dirección de la página, que el bot pone en sus avisos de que el
# juego se mudó. Sin ella vale la pública.
# URL_GACHAMON=https://rowino.online/gachamon

# Opcional, sólo para la web (/gachamon): la MISMA SECRET_KEY que usa Rowino
# para firmar su cookie de sesión. Nunca se escribe en el repositorio.
ROWINO_SECRET_KEY=

# Opcional, sólo para la web: la base de Rowino, que se lee para saber quién es
# la cookie. Sin esto vale ../rowino_web/rowino.db junto al repositorio.
# RUTA_ROWINO_BD=

# Opcional: canal donde el bot mantiene su única página de manual: que el juego
# se mudó a la página, cómo vincular y en qué canal del juego de ese servidor se
# escribe /vincular. En un servidor que no es el de la página, la página es el
# aviso de la pausa. La EDITA en el sitio si cambia, y borra las otras páginas
# del manual de antes. Cada servidor puede tener el suyo, separados por comas.
#   CANAL_INFO_ID=123456789012345678,987654321098765432
#
# Déjale al bot permiso para escribir y para editar sus propios mensajes, y
# quítaselo a los demás: es un tablón, no una conversación.
CANAL_INFO_ID=

# Hoy no se usa: conversar está en pausa junto con el juego de Discord. Se
# deja por si vuelve en la página.
# Opcional: con esto las criaturas hablarán.
# Se saca de https://build.nvidia.com -> cualquier modelo -> Get API Key.
NVIDIA_API_KEY=

# Hoy no se usa (conversar está en pausa).
# Opcional y de pago: https://platform.deepseek.com -> API keys.
# Los modelos de NVIDIA son gratis pero pequeños, y se les notan las erratas
# («la puente», «bostecando»). DeepSeek escribe mejor y cuesta unos céntimos.
# Se puede tener las dos: DeepSeek de principal y NVIDIA de recambio.
DEEPSEEK_API_KEY=

# Hoy no se usa (conversar está en pausa).
# Opcional: modelos a probar en orden, separados por comas, cada uno con su
# proveedor delante. Sin prefijo se asume nvidia. NVIDIA marca modelos como
# DEGRADED sin avisar, así que el bot se pasa al siguiente solo; y si DeepSeek
# se cae o se te acaba el saldo, contestan igualmente los gratuitos.
#
#   MODELO_IA=deepseek:deepseek-v4-pro,mistralai/mistral-nemotron,nvidia/llama-3.3-nemotron-super-49b-v1.5
#
# Los modelos de un proveedor sin clave se saltan solos, así que puedes dejar
# DeepSeek escrito antes de haber pagado y no estorba.
# MODELO_IA=
