# Copia este fichero a .env y rellena los valores.
# El .env NO se sube a git ni viaja en el deploy.

# https://discord.com/developers/applications -> tu app -> Bot -> Reset Token
DISCORD_TOKEN=

# Canal donde vive el bot. Clic derecho en el canal -> Copiar ID
# (Ajustes -> Avanzado -> Modo desarrollador)
#
# Para varios canales, sepáralos por comas. El PRIMERO es el principal: ahí van
# los avisos de las criaturas que aún no tienen canal propio guardado.
#   CANAL_ID=123456789012345678,987654321098765432
CANAL_ID=

# Servidores donde registrar los comandos al instante (clic derecho en el icono
# del servidor -> Copiar ID). Sin esto Discord tarda hasta una hora.
# También admite varios separados por comas:
#   GUILD_ID=123456789012345678,987654321098765432
#
# Cada servidor lleva sus propias mascotas y su propio ranking. Recuerda meter
# en CANAL_ID el canal de cada uno.
GUILD_ID=

# Opcional: con esto las criaturas hablan (menciona al bot para charlar).
# Se saca de https://build.nvidia.com -> cualquier modelo -> Get API Key.
# Sin ella el bot funciona igual, pero las criaturas sólo dicen sus frases
# escritas a mano en vez de conversar.
NVIDIA_API_KEY=

# Opcional y de pago: https://platform.deepseek.com -> API keys.
# Los modelos de NVIDIA son gratis pero pequeños, y se les notan las erratas
# («la puente», «bostecando»). DeepSeek escribe mejor y cuesta unos céntimos.
# Se puede tener las dos: DeepSeek de principal y NVIDIA de recambio.
DEEPSEEK_API_KEY=

# Opcional: modelos a probar en orden, separados por comas, cada uno con su
# proveedor delante. Sin prefijo se asume nvidia. NVIDIA marca modelos como
# DEGRADED sin avisar, así que el bot se pasa al siguiente solo; y si DeepSeek
# se cae o se te acaba el saldo, contestan igualmente los gratuitos.
#
#   MODELO_IA=deepseek:deepseek-v4-pro,mistralai/mistral-nemotron,nvidia/llama-3.3-nemotron-super-49b-v1.5
#
# Los modelos de un proveedor sin clave se saltan solos, así que puedes dejar
# DeepSeek escrito antes de haber pagado y no estorba.
# MODELO_IA=
